# camera
CAMERA_SOURCE=0
# RTSP example: rtsp://user:pass@192.168.10.50:554/stream1

# detection
YOLO_MODEL=yolo26n.pt
CONF_THRESHOLD=0.4
ALLOWED_LABELS=dog,person
MIN_CONSECUTIVE=2

# event gate
COOLDOWN_SECONDS=45

# local persistence
SAVE_SNAPSHOTS=true
SNAPSHOTS_DIR=data/snapshots
EVENT_LOG_PATH=data/events/events.jsonl

# notify (optional)
NOTIFY_ENABLED=true
DISCORD_WEBHOOK_URL=
